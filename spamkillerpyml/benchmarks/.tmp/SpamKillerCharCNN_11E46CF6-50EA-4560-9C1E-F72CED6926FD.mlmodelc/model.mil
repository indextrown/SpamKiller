program(1.0)
[buildInfo = dict<tensor<string, []>, tensor<string, []>>({{"coremlc-component-MIL", "3405.2.1"}, {"coremlc-version", "3405.2.1"}, {"coremltools-component-torch", "2.11.0"}, {"coremltools-source-dialect", "TorchScript"}, {"coremltools-version", "9.0"}})]
{
    func main<ios15>(tensor<int32, [1, 128]> char_ids) {
            tensor<int32, []> embedded_axis_0 = const()[name = tensor<string, []>("embedded_axis_0"), val = tensor<int32, []>(0)];
            tensor<fp16, [358, 64]> embedding_weight_to_fp16 = const()[name = tensor<string, []>("embedding_weight_to_fp16"), val = tensor<fp16, [358, 64]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(64)))];
            tensor<fp16, [1, 128, 64]> embedded_cast_fp16 = gather(axis = embedded_axis_0, indices = char_ids, x = embedding_weight_to_fp16)[name = tensor<string, []>("embedded_cast_fp16")];
            tensor<int32, [3]> input_1_perm_0 = const()[name = tensor<string, []>("input_1_perm_0"), val = tensor<int32, [3]>([0, 2, 1])];
            tensor<string, []> input_3_pad_type_0 = const()[name = tensor<string, []>("input_3_pad_type_0"), val = tensor<string, []>("custom")];
            tensor<int32, [2]> input_3_pad_0 = const()[name = tensor<string, []>("input_3_pad_0"), val = tensor<int32, [2]>([2, 2])];
            tensor<int32, [1]> input_3_strides_0 = const()[name = tensor<string, []>("input_3_strides_0"), val = tensor<int32, [1]>([1])];
            tensor<int32, [1]> input_3_dilations_0 = const()[name = tensor<string, []>("input_3_dilations_0"), val = tensor<int32, [1]>([1])];
            tensor<int32, []> input_3_groups_0 = const()[name = tensor<string, []>("input_3_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [128, 64, 5]> conv_weight_to_fp16 = const()[name = tensor<string, []>("conv_weight_to_fp16"), val = tensor<fp16, [128, 64, 5]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(45952)))];
            tensor<fp16, [128]> conv_bias_to_fp16 = const()[name = tensor<string, []>("conv_bias_to_fp16"), val = tensor<fp16, [128]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(127936)))];
            tensor<fp16, [1, 64, 128]> input_1_cast_fp16 = transpose(perm = input_1_perm_0, x = embedded_cast_fp16)[name = tensor<string, []>("transpose_0")];
            tensor<fp16, [1, 128, 128]> input_3_cast_fp16 = conv(bias = conv_bias_to_fp16, dilations = input_3_dilations_0, groups = input_3_groups_0, pad = input_3_pad_0, pad_type = input_3_pad_type_0, strides = input_3_strides_0, weight = conv_weight_to_fp16, x = input_1_cast_fp16)[name = tensor<string, []>("input_3_cast_fp16")];
            tensor<fp16, [1, 128, 128]> input_5_cast_fp16 = relu(x = input_3_cast_fp16)[name = tensor<string, []>("input_5_cast_fp16")];
            tensor<int32, [1]> reduce_max_0_axes_0 = const()[name = tensor<string, []>("reduce_max_0_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<bool, []> reduce_max_0_keep_dims_0 = const()[name = tensor<string, []>("reduce_max_0_keep_dims_0"), val = tensor<bool, []>(true)];
            tensor<fp16, [1, 128, 1]> reduce_max_0_cast_fp16 = reduce_max(axes = reduce_max_0_axes_0, keep_dims = reduce_max_0_keep_dims_0, x = input_5_cast_fp16)[name = tensor<string, []>("reduce_max_0_cast_fp16")];
            tensor<int32, []> concat_0_axis_0 = const()[name = tensor<string, []>("concat_0_axis_0"), val = tensor<int32, []>(-1)];
            tensor<bool, []> concat_0_interleave_0 = const()[name = tensor<string, []>("concat_0_interleave_0"), val = tensor<bool, []>(false)];
            tensor<fp16, [1, 128, 1]> concat_0_cast_fp16 = concat(axis = concat_0_axis_0, interleave = concat_0_interleave_0, values = reduce_max_0_cast_fp16)[name = tensor<string, []>("concat_0_cast_fp16")];
            tensor<int32, [1]> input_axes_0 = const()[name = tensor<string, []>("input_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp16, [1, 128]> input_cast_fp16 = squeeze(axes = input_axes_0, x = concat_0_cast_fp16)[name = tensor<string, []>("input_cast_fp16")];
            tensor<fp16, [1, 128]> fc_weight_to_fp16 = const()[name = tensor<string, []>("fc_weight_to_fp16"), val = tensor<fp16, [1, 128]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(128256)))];
            tensor<fp16, [1]> fc_bias_to_fp16 = const()[name = tensor<string, []>("fc_bias_to_fp16"), val = tensor<fp16, [1]>([-0x1.148p-5])];
            tensor<fp16, [1, 1]> linear_0_cast_fp16 = linear(bias = fc_bias_to_fp16, weight = fc_weight_to_fp16, x = input_cast_fp16)[name = tensor<string, []>("linear_0_cast_fp16")];
            tensor<int32, [1]> var_35_axes_0 = const()[name = tensor<string, []>("op_35_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp16, [1]> var_35_cast_fp16 = squeeze(axes = var_35_axes_0, x = linear_0_cast_fp16)[name = tensor<string, []>("op_35_cast_fp16")];
            tensor<string, []> var_35_cast_fp16_to_fp32_dtype_0 = const()[name = tensor<string, []>("op_35_cast_fp16_to_fp32_dtype_0"), val = tensor<string, []>("fp32")];
            tensor<fp32, [1]> logits = cast(dtype = var_35_cast_fp16_to_fp32_dtype_0, x = var_35_cast_fp16)[name = tensor<string, []>("cast_1")];
        } -> (logits);
}